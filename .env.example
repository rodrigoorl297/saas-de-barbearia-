# Copie este arquivo para .env e ajuste os valores.
# Nunca versionar o .env com segredos reais.

PRODUCT_NAME=Barba Flow
PRODUCT_LOGO=assets/img/logo-barba-flow.png
APP_SLUG=barbaflow
APP_URL=
TIMEZONE=America/Sao_Paulo

# production | development — em production, CLIENT_DEMO_OPEN é sempre ignorado
# (trava de segurança), mesmo que fique =true aqui por engano.
APP_ENV=production
CLIENT_DEMO_OPEN=false

# Chave para criptografar em repouso os tokens de Mercado Pago/WhatsApp salvos em
# Configurações. Gere uma com: php -r "echo base64_encode(random_bytes(32));"
# Sem essa chave, os tokens são salvos em texto plano (comportamento anterior).
APP_KEY=

MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=

# ---- MySQL (1 banco = 1 barbearia) ----
# Na hospedagem: DB_ENABLED=true e dados do painel (phpMyAdmin).
DB_ENABLED=false
DB_HOST=localhost
DB_PORT=3306
DB_NAME=barbaflow
DB_USER=barbaflow
DB_PASS=
