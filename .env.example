# Copie este arquivo para .env e ajuste os valores.
# Nunca versionar o .env com segredos reais.

PRODUCT_NAME=Barba Flow
PRODUCT_LOGO=assets/img/logo-barba-flow.png
APP_SLUG=barbaflow
APP_URL=
TIMEZONE=America/Sao_Paulo
CLIENT_DEMO_OPEN=false

MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=

# ---- MySQL (1 banco = 1 barbearia) ----
# Na hospedagem: DB_ENABLED=true e dados do painel (phpMyAdmin).
DB_ENABLED=false
DB_HOST=localhost
DB_PORT=3306
DB_NAME=barbaflow
DB_USER=barbaflow
DB_PASS=
